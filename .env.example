# Copy these into Coolify's Environment Variables panel. Do not commit real values.

# ---- site ----
SITE_URL=https://mojavemedclinic.com
SITE_HOST=mojavemedclinic.com
PORT=3000
HOST=0.0.0.0

# ---- staff dashboard at /admin ----
# Staff sign in with a form; the session is a signed, HttpOnly, SameSite=Strict cookie.
# The same credentials also work as HTTP Basic auth for scripts and the CSV export.
# Generate a long random password:  openssl rand -base64 24
ADMIN_USER=frontdesk
ADMIN_PASS=CHANGE_ME_LONG_RANDOM
# How long a signed-in session lasts, and how many wrong passwords an IP gets before
# it is locked out for an escalating cool-off.
SESSION_HOURS=8
LOGIN_ATTEMPTS=8
# Optional. Leave empty and the session key is derived from ADMIN_PASS + IP_SALT, which
# means changing the password signs everyone out. Set it (openssl rand -hex 32) if you
# would rather sessions survive a password change.
SESSION_SECRET=

# ---- SMTP ----
# Google Workspace (BAA available on Business/Enterprise; use an App Password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=hello@mojavemedclinic.com
# Amazon SES (BAA available, cheapest at volume):
#   SMTP_HOST=email-smtp.us-west-2.amazonaws.com  SMTP_PORT=587
# Paubox / LuxSci (HIPAA-first, BAA standard):  see their SMTP docs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mojave Medical <no-reply@mojavemedclinic.com>
MAIL_TO=kevin.ganesh@mojavemedclinic.com

# Keep this false unless a BAA is signed with BOTH the SMTP provider and the
# receiving mailbox provider. False = staff emails contain only a reference
# number; the patient's details stay behind the /admin login.
MAIL_INCLUDE_DETAILS=false
MAIL_CONFIRM_PATIENT=true

# ---- hardening ----
TRUST_PROXY=true
# openssl rand -hex 16   (salts the stored IP hash; changing it resets the hashes)
IP_SALT=
RATE_LIMIT_PER_HOUR=8
# Reads of the public /api/availability calendar, per IP per five minutes.
RATE_LIMIT_AVAILABILITY=120
# Auto-delete closed requests after N days. 0 = keep everything.
RETAIN_DAYS=0
# Only for local development over plain http, where a Secure cookie would be dropped.
# Never set this to false in production.
# SECURE_COOKIE=false
